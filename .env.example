# 複製成 .env 後使用：cp .env.example .env
# 本機開發用的值；dev 環境（EC2）要另外設定
DB_USER=app
DB_PASSWORD=app
DB_NAME=vitals

# pgAdmin 登入帳密（只在本機用，email 只需格式正確）
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# 預設帳號：系統啟動時建立，帳號最多 50 個字、密碼最多 64 個字
# 值不加引號：後端把這個檔當成 properties 讀，引號會變成值的一部分
ADMIN_USERNAME=nurse01
ADMIN_PASSWORD=change-me-local-only
ADMIN_NAME=陳小白

# 簽發登入憑證的密鑰，至少 32 byte；dev 環境要換成隨機產生的值
JWT_SECRET=local-only-secret-change-me-32-bytes-min

# 登入有效期限，沒設定時是 12h
JWT_EXPIRY=12h

# 登入憑證的 cookie 只走 HTTPS；本機是 http 要 false，dev 環境（HTTPS）設 true
COOKIE_SECURE=false

# 只有 dev 環境用：要啟動的 image 版本（git commit 的短 hash），見 docs/devops/setup-dev.md
VERSION=
